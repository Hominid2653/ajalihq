FLASK_ENV=development
SECRET_KEY=change-me-in-development-use-a-long-random-string
# Must be at least 32 characters for production-grade JWT signing.
JWT_SECRET_KEY=change-me-jwt-in-development-at-least-32-chars

# Supabase PostgreSQL (Project Settings → Database → Connection string)
# Use the URI form and swap the scheme to postgresql+psycopg://
# Direct (port 5432) or Session pooler (port 5432 / 6543 depending on mode):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Optional SQLAlchemy pool tuning (defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_SERVER_URL=http://127.0.0.1:5000

# Auth rate limits (sliding window; dual key: IP + email). Demo-friendly defaults.
RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=60

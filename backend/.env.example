FLASK_ENV=development
SECRET_KEY=change-me-in-development-use-a-long-random-string
# Must be at least 32 characters for production-grade JWT signing.
JWT_SECRET_KEY=change-me-jwt-in-development-at-least-32-chars

# Supabase PostgreSQL (Project Settings → Database → Connection string)
# Use the URI form and swap the scheme to postgresql+psycopg://
# Direct (port 5432) or Session pooler (port 5432 / 6543 depending on mode):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Optional SQLAlchemy pool tuning (defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ajalihq.vercel.app,https://ajali.vercel.app
# Optional: explicit external API URL for Swagger (omit to auto-detect current host)
# API_SERVER_URL=http://127.0.0.1:5000

# --- External notifications ---
# Resend (EMAIL). Leave RESEND_API_KEY empty to dry-run (DB row only).
# Dev from-address: Ajali! <onboarding@resend.dev> — can only send to your Resend account email
# until you verify a domain at https://resend.com/domains
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ajali! <onboarding@resend.dev>
NOTIFICATIONS_EMAIL_ENABLED=true

# Africa's Talking (SMS) — deferred; dry-run until wired
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=
# NOTIFICATIONS_SMS_ENABLED=false

# --- Supabase Storage (Incident media uploads) ---
# Project URL e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# Service role key or anon key with storage permissions
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=incident-media

# --- Open-Meteo (same public bases as frontend VITE_* ) ---
# No API key. Hosts must stay on the allow-list in openmeteo_client.py
GEOCODE_API_BASE=https://geocoding-api.open-meteo.com
WEATHER_API_BASE=https://api.open-meteo.com
OPEN_METEO_TIMEOUT_SECONDS=8

# Copy to .env (already created in this project).
# Vite loads VITE_* at build time. HTTPS allow-list is in src/lib/public-http.ts.

VITE_API_BASE=http://127.0.0.1:5000
VITE_USE_MOCK_API=false

VITE_GEOCODE_API_BASE=https://geocoding-api.open-meteo.com
VITE_WEATHER_API_BASE=https://api.open-meteo.com

